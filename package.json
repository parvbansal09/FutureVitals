{
  "name": "futurevitals",
  "version": "2.0.0",
  "private": true,
  "description": "FutureVitals: a cancer screening navigation app for Virginia communities. On-device, bilingual (EN/ES), offline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run test && npm run check:content",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run check && npm run build && npm run e2e && npm run a11y",
    "icons": "node scripts/make-icons.mjs",
    "zips": "node scripts/build-zip-table.mjs",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "sync": "npm run build && cap sync",
    "open:android": "npm run sync && cap open android",
    "open:ios": "npm run sync && cap open ios",
    "shots": "node scripts/screenshots.mjs",
    "a11y": "node scripts/a11y-targets.mjs",
    "artifact": "node scripts/build-artifact.mjs",
    "grades": "node scripts/grade-products.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "lucide-react": "^1.48.0",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
